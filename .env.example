# ---------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------
# Supabase Dashboard → Project Settings → API
# Leave BOTH blank to run the app in demo mode (in-memory store, no DB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required to publish Top 3 from /admin.
# NEVER prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Admin console
# ---------------------------------------------------------------------
# Shared password for /admin. Set something long.
ADMIN_PASSWORD=

# Optional: separate secret used to sign the admin session cookie.
# Falls back to ADMIN_PASSWORD when empty.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------
# Event branding (all optional — defaults live in src/lib/event-config.ts)
# ---------------------------------------------------------------------
NEXT_PUBLIC_EVENT_ORG=ASTRA INTERNATIONAL
NEXT_PUBLIC_EVENT_NAME=ASTRA LEARN FEST
NEXT_PUBLIC_EVENT_TAGLINE=KNOWLEDGE MANAGEMENT FEST 2026
NEXT_PUBLIC_EVENT_QUESTION=Apa satu hal yang ingin Anda perbaiki atau tingkatkan dari perusahaan?

# Public base URL, used by /qr to build the QR target.
# Leave blank to use the browser's own origin.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------
# Automatic Top 3 summarize (optional)
# ---------------------------------------------------------------------
# Replaces the manual "copy prompt into ChatGPT/paste JSON back" flow in
# /admin with a timer: an external scheduler (cron-job.org, GitHub Actions,
# etc — see README) hits GET /api/cron/auto-summarize every few minutes,
# which asks Gemini to re-summarize current feedback and publishes the
# result straight to Top 3, no operator action needed.
#
# Free API key from https://aistudio.google.com (no credit card).
GEMINI_API_KEY=

# Any long random string you make up yourself. The scheduler must send the
# exact same value back on every call (as `Authorization: Bearer <value>`
# or `?secret=<value>`) or the route rejects the request.
CRON_SECRET=
